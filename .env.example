OPENAI_API_KEY=
GERALD_MODEL=gpt-realtime-2
GERALD_VOICE=marin
GERALD_HOTKEY=ctrl+shift
GERALD_MAX_IMAGE_W=1280
GERALD_OCR_BUDGET=2.5
GERALD_REQUIRE_CONFIRMATION=1
